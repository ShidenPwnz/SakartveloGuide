<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- ARCHITECT'S FIX: Explicitly disable cleartext (HTTP) for production security -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>